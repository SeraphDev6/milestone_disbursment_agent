# mock: no keys needed (fake PayPal ids, canned verifier). sandbox: real PayPal sandbox.
MODE=mock

# Leave unset for SQLite at ./local.db, or use the docker-compose Postgres:
# DATABASE_URL=postgresql://milestone:milestone@localhost:5433/milestone

# Required when MODE=sandbox (developer.paypal.com > Apps & Credentials, Sandbox).
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# Webhook id from the sandbox app's Webhooks section; without it PayPal webhooks are rejected.
# PAYPAL_WEBHOOK_ID=

# Public URL PayPal sends the payer back to after approving a hold (Render sets RENDER_EXTERNAL_URL).
# PUBLIC_BASE_URL=http://localhost:8000
