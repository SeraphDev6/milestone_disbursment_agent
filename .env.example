# mock: no keys needed (fake PayPal ids, canned verifier). sandbox: real PayPal sandbox. live: production PayPal
# (needs PayPal partner approval; pays connected payees only, requires https PUBLIC_BASE_URL and PAYPAL_WEBHOOK_ID).
MODE=mock

# Leave unset for SQLite at ./local.db, or use the docker-compose Postgres:
# DATABASE_URL=postgresql://milestone:milestone@localhost:5433/milestone

# Required when MODE=sandbox or live (developer.paypal.com > Apps & Credentials).
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# Webhook id from the app's Webhooks section; without it PayPal webhooks are rejected.
# PAYPAL_WEBHOOK_ID=
# Create the app as a Platform (partner) app so payees can connect PayPal and be paid directly.
# The platform's own merchant id is looked up once when unset; the BN code comes with live partner approval.
# PAYPAL_PARTNER_MERCHANT_ID=
# PAYPAL_BN_CODE=
# PayPal API host; unset follows MODE (sandbox or live).
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Sandbox test accounts (emails only) used by scripts/paypal_sandbox_check.py: a personal account (funder), a
# business account other than the app owner (payee).
# PAYPAL_TEST_PAYER_EMAIL=
# PAYPAL_TEST_PAYEE_EMAIL=
# Their sandbox passwords: scripts/sandbox_walkthrough.py then signs in and approves PayPal pages itself.
# PAYPAL_TEST_PAYER_PASSWORD=
# PAYPAL_TEST_PAYEE_PASSWORD=
# A Resend receiving domain and a FULL-ACCESS key (local only, never on the deployment): the walkthrough then
# signs people up at that domain and reads their sign-in and invitation emails itself.
# RESEND_INBOX_DOMAIN=
# RESEND_INBOX_API_KEY=
# How often the app pays tranches whose dispute window closed (seconds; 0 = only `python -m app.jobs payouts`,
# which is what to use with more than one app instance).
# PAYOUTS_INTERVAL_SECONDS=300

# The site's public URL: the web app at /, the REST API under /api (PayPal returns, pay links, webhooks) and the
# MCP server at /mcp. Render sets RENDER_EXTERNAL_URL.
# PUBLIC_BASE_URL=http://localhost:8000
# Only for the dev split (Vite on 5173, the API on 8000): where emailed links and SSO returns should land.
# Unset, they open the web app when web/dist exists and the API's own pages otherwise.
# PUBLIC_APP_URL=http://localhost:5173

# AI (extraction + verification) runs through Pydantic AI. Unset LLM follows MODE: mock -> deterministic
# stand-in, sandbox/live -> Claude. Set LLM=claude to use Claude with mock PayPal.
# LLM=claude
# ANTHROPIC_API_KEY=

# Outgoing email: sign-in links, invitations, review requests, rejections, pay links, overdue and payout notices.
# console (default) only logs them; mock mode also returns links in API responses. resend needs RESEND_API_KEY;
# smtp needs SMTP_HOST (STARTTLS when offered) and optionally SMTP_PORT (587), SMTP_USERNAME, SMTP_PASSWORD.
# EMAIL_PROVIDER=resend
# EMAIL_FROM=Milestone Ledger <notify@mail.milestone-ledger.com>
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Per-client limits per hour (in memory, per app instance; 0 turns one off): sign-in links per IP (and half that
# per email address), extraction and pre-check per caller, pay-link visits per IP.
# RATE_LIMIT_MAGIC_LINK_PER_HOUR=20
# RATE_LIMIT_EXTRACT_PER_HOUR=30
# RATE_LIMIT_PRECHECK_PER_HOUR=60
# RATE_LIMIT_PAY_LINK_PER_HOUR=30
# Read the client IP from X-Forwarded-For (true behind Render or another reverse proxy; false when exposed directly).
# TRUST_PROXY_HEADERS=true

# When set, POST /agreements and POST /agreements/extract (which spends model credits) need X-Org-Key.
# ORG_API_KEY=

# Optional GitHub token for the GitHub evidence adapter (higher rate limits, private repos).
# GITHUB_TOKEN=
# GitHub App, from `uv run python scripts/github_app_setup.py --public-url https://your.host` (writes github-app.env).
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Encrypts stored secrets (orgs' SSO client secrets) and signs browser CSRF tokens. Required outside mock mode;
# keep it stable: stored files are encrypted with a key derived from it unless FILE_ENCRYPTION_KEY is set. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=
# Stored files are encrypted at rest with this key (32 bytes, base64: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"),
# or with a key derived from SECRET_KEY when unset. When rotating, list previous keys here and run `python -m app.jobs encrypt-files`.
# FILE_ENCRYPTION_KEY=
# FILE_ENCRYPTION_OLD_KEYS=
# Custody: days after a tranche closes before the daily job deletes its originals (or makes them payee-only).
# Never within 180 days of capture. Unset keeps them.
# RETENTION_DAYS=
# RETENTION_ACTION=delete
