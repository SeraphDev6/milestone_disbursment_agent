# mock: no keys needed (fake PayPal ids, canned verifier). sandbox: real PayPal sandbox.
MODE=mock

# Leave unset for SQLite at ./local.db, or use the docker-compose Postgres:
# DATABASE_URL=postgresql://milestone:milestone@localhost:5433/milestone

# Required when MODE=sandbox (developer.paypal.com > Apps & Credentials, Sandbox).
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# Webhook id from the sandbox app's Webhooks section; without it PayPal webhooks are rejected.
# PAYPAL_WEBHOOK_ID=
# Create the app as a Platform (partner) app so payees can connect PayPal and be paid directly.
# The platform's own merchant id is looked up once when unset; the BN code comes with live partner approval.
# PAYPAL_PARTNER_MERCHANT_ID=
# PAYPAL_BN_CODE=
# Sandbox test accounts (emails only) used by manual checks: a personal account (funder), a business account
# other than the app owner (payee).
# PAYPAL_TEST_PAYER_EMAIL=
# PAYPAL_TEST_PAYEE_EMAIL=
# How often the app pays tranches whose dispute window closed (seconds; 0 = only `python -m app.jobs payouts`).
# PAYOUTS_INTERVAL_SECONDS=300

# Public URL PayPal sends the payer back to after approving a hold (Render sets RENDER_EXTERNAL_URL).
# PUBLIC_BASE_URL=http://localhost:8000

# AI (extraction + verification) runs through Pydantic AI. Unset LLM follows MODE: mock -> deterministic
# stand-in, sandbox -> Claude. Set LLM=claude to use Claude with mock PayPal.
# LLM=claude
# ANTHROPIC_API_KEY=

# When set, POST /agreements and POST /agreements/extract (which spends model credits) need X-Org-Key.
# ORG_API_KEY=

# Optional GitHub token for the GitHub evidence adapter (higher rate limits, private repos).
# GITHUB_TOKEN=

# Encrypts stored secrets (orgs' SSO client secrets). Required outside mock mode; keep it stable.
# SECRET_KEY=
