{
  "name": "mde-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "tokens:check": "tsx scripts/tokens.ts --check",
    "api:types": "cd .. && uv run python -c \"import json; from app.main import create_app; print(json.dumps(create_app().openapi()))\" > web/openapi.json && cd web && openapi-typescript openapi.json --default-non-nullable false -o src/api/schema.d.ts",
    "check": "npm run typecheck && npm run lint && npm run tokens:check && npm test",
    "tokens": "tsx scripts/tokens.ts"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@tanstack/react-query": "^5.105.3",
    "ag-charts-community": "^14.2.0",
    "ag-charts-react": "^14.2.0",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.14.0",
    "culori": "^4.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^27.0.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
